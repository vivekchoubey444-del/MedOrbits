{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medorbits.in/schemas/manifest.schema.json",
  "title": "MedOrbits Repository Inventory Manifest",
  "description": "Schema for validating the MedOrbits repository inventory manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "name",
    "manifestVersion",
    "manifestType",
    "description",
    "repositoryRoot",
    "statusSemantics",
    "statusRules",
    "brand",
    "runtime",
    "projectAreas",
    "documentCollections",
    "security",
    "quality",
    "git",
    "dataGovernance",
    "manifestValidation",
    "maintenance",
    "notes",
    "schemaFile"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "const": "MedOrbits"
    },
    "manifestVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "manifestType": {
      "const": "repository-inventory"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "repositoryRoot": {
      "const": "."
    },
    "statusSemantics": {
      "type": "object",
      "required": [
        "planned",
        "existing",
        "deprecated",
        "missing",
        "ignored"
      ],
      "properties": {
        "planned": {
          "type": "string",
          "minLength": 1
        },
        "existing": {
          "type": "string",
          "minLength": 1
        },
        "deprecated": {
          "type": "string",
          "minLength": 1
        },
        "missing": {
          "type": "string",
          "minLength": 1
        },
        "ignored": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "statusRules": {
      "type": "object",
      "required": [
        "defaultStatus",
        "requireVerificationBeforeExisting",
        "requireReplacementForDeprecated",
        "requireReasonForMissing",
        "repositoryPathsMustBeRelative",
        "repositoryPathsMustNotEscapeRoot",
        "caseSensitivePathValidation",
        "requireStatusForInventoryItems"
      ],
      "properties": {
        "defaultStatus": {
          "enum": [
            "planned",
            "existing",
            "deprecated",
            "missing",
            "ignored"
          ]
        },
        "requireVerificationBeforeExisting": {
          "type": "boolean"
        },
        "requireReplacementForDeprecated": {
          "type": "boolean"
        },
        "requireReasonForMissing": {
          "type": "boolean"
        },
        "repositoryPathsMustBeRelative": {
          "type": "boolean"
        },
        "repositoryPathsMustNotEscapeRoot": {
          "type": "boolean"
        },
        "caseSensitivePathValidation": {
          "type": "boolean"
        },
        "requireStatusForInventoryItems": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "brand": {
      "type": "object",
      "required": [
        "name",
        "designDirection",
        "visualGuidance"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "designDirection": {
          "type": "string"
        },
        "visualGuidance": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "platform",
        "minimumNodeVersion",
        "versionSource",
        "packageManager",
        "packageManifest",
        "lockfile",
        "nodeVersionFile",
        "environmentTemplate",
        "entryPoints",
        "startupPolicy"
      ],
      "properties": {
        "platform": {
          "type": "string"
        },
        "minimumNodeVersion": {
          "type": "string"
        },
        "versionSource": {
          "type": "string"
        },
        "packageManager": {
          "type": "string"
        },
        "packageManifest": {
          "type": "string"
        },
        "lockfile": {
          "type": "string"
        },
        "nodeVersionFile": {
          "type": "string"
        },
        "environmentTemplate": {
          "type": "string"
        },
        "entryPoints": {
          "type": "object",
          "required": [
            "server",
            "application",
            "frontend"
          ],
          "properties": {
            "server": {
              "$ref": "#/$defs/inventoryItem"
            },
            "application": {
              "$ref": "#/$defs/inventoryItem"
            },
            "frontend": {
              "$ref": "#/$defs/inventoryItem"
            }
          },
          "additionalProperties": false
        },
        "startupPolicy": {
          "type": "object",
          "required": [
            "singleDocumentedProductionCommand",
            "entryPointMustBeVerified",
            "frontendServingStrategyMustBeDocumented",
            "environmentVariablesMustBeValidated",
            "runtimeVersionMustMatchDeployment"
          ],
          "properties": {
            "singleDocumentedProductionCommand": {
              "type": "boolean"
            },
            "entryPointMustBeVerified": {
              "type": "boolean"
            },
            "frontendServingStrategyMustBeDocumented": {
              "type": "boolean"
            },
            "environmentVariablesMustBeValidated": {
              "type": "boolean"
            },
            "runtimeVersionMustMatchDeployment": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "projectAreas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "purpose",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "path": {
            "$ref": "#/$defs/repositoryPath"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "subareas": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/repositoryPath"
            }
          },
          "databaseEngine": {
            "type": "string"
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gitPolicy": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "documentCollections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "purpose",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "path": {
            "$ref": "#/$defs/repositoryPath"
          },
          "manifest": {
            "$ref": "#/$defs/repositoryPath"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "contentRequirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "security": {
      "type": "object",
      "required": [
        "neverCommitSecrets",
        "environmentSecretsSource",
        "environmentTemplate",
        "privateStorageMustBeProtected",
        "privateRecordsRequireAuthorization",
        "verifyPaymentWebhooks",
        "useParameterizedDatabaseQueries",
        "reviewDependenciesAndRunSecurityChecks",
        "doNotPublishPrivateApplicantDocuments",
        "doNotTrustClientSuppliedRolesOrPaymentStates",
        "useSyntheticTestData",
        "securityReportingDocument",
        "authenticationRequirements",
        "uploadRequirements"
      ],
      "properties": {
        "neverCommitSecrets": {
          "type": "boolean"
        },
        "privateStorageMustBeProtected": {
          "type": "boolean"
        },
        "privateRecordsRequireAuthorization": {
          "type": "boolean"
        },
        "verifyPaymentWebhooks": {
          "type": "boolean"
        },
        "useParameterizedDatabaseQueries": {
          "type": "boolean"
        },
        "reviewDependenciesAndRunSecurityChecks": {
          "type": "boolean"
        },
        "doNotPublishPrivateApplicantDocuments": {
          "type": "boolean"
        },
        "doNotTrustClientSuppliedRolesOrPaymentStates": {
          "type": "boolean"
        },
        "useSyntheticTestData": {
          "type": "boolean"
        },
        "environmentSecretsSource": {
          "type": "string"
        },
        "environmentTemplate": {
          "type": "string"
        },
        "securityReportingDocument": {
          "type": "string"
        },
        "authenticationRequirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uploadRequirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "required": [
        "formattingConfig",
        "lintConfig",
        "editorConfig",
        "testDirectory",
        "documentationDirectory",
        "workflowDirectory",
        "rules"
      ],
      "properties": {
        "formattingConfig": {
          "type": "string"
        },
        "lintConfig": {
          "type": "string"
        },
        "editorConfig": {
          "type": "string"
        },
        "testDirectory": {
          "type": "string"
        },
        "documentationDirectory": {
          "type": "string"
        },
        "workflowDirectory": {
          "type": "string"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "git": {
      "type": "object",
      "required": [
        "ignoreFile",
        "attributesFile",
        "requiredTrackedFiles",
        "requiredTrackedFilesArePolicy",
        "rules",
        "recommendedChecks"
      ],
      "properties": {
        "ignoreFile": {
          "type": "string"
        },
        "attributesFile": {
          "type": "string"
        },
        "requiredTrackedFiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/repositoryPath"
          }
        },
        "requiredTrackedFilesArePolicy": {
          "type": "string"
        },
        "rules": {
          "type": "object",
          "required": [
            "gitDoesNotTrackEmptyDirectories",
            "doNotCommitEnvironmentFiles",
            "doNotCommitRuntimeStorage",
            "doNotCommitNodeModules",
            "doNotCommitProductionDatabaseDumps",
            "preserveLockfile",
            "respectCaseSensitivePaths",
            "checkIgnoredFilesBeforeAdding",
            "avoidForceAddingSecrets"
          ],
          "properties": {
            "gitDoesNotTrackEmptyDirectories": {
              "type": "boolean"
            },
            "doNotCommitEnvironmentFiles": {
              "type": "boolean"
            },
            "doNotCommitRuntimeStorage": {
              "type": "boolean"
            },
            "doNotCommitNodeModules": {
              "type": "boolean"
            },
            "doNotCommitProductionDatabaseDumps": {
              "type": "boolean"
            },
            "preserveLockfile": {
              "type": "boolean"
            },
            "respectCaseSensitivePaths": {
              "type": "boolean"
            },
            "checkIgnoredFilesBeforeAdding": {
              "type": "boolean"
            },
            "avoidForceAddingSecrets": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "recommendedChecks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "dataGovernance": {
      "type": "object",
      "required": [
        "publicDataMustBeReviewed",
        "timeSensitiveEducationInformationMustBeVerified",
        "feeAndAdmissionClaimsMustUseOfficialSources",
        "privateRecordsMustNotBeStoredInPublicAssets",
        "keepDirectoryManifestsSynchronized",
        "useSyntheticDataInFixtures",
        "avoidUnsupportedAdmissionOrEmploymentGuarantees",
        "recordSourceAndReviewDateForTimeSensitiveData",
        "minimizePersonalDataCollection",
        "documentRetentionAndDeletionPractices"
      ],
      "properties": {
        "publicDataMustBeReviewed": {
          "type": "boolean"
        },
        "timeSensitiveEducationInformationMustBeVerified": {
          "type": "boolean"
        },
        "feeAndAdmissionClaimsMustUseOfficialSources": {
          "type": "boolean"
        },
        "privateRecordsMustNotBeStoredInPublicAssets": {
          "type": "boolean"
        },
        "keepDirectoryManifestsSynchronized": {
          "type": "boolean"
        },
        "useSyntheticDataInFixtures": {
          "type": "boolean"
        },
        "avoidUnsupportedAdmissionOrEmploymentGuarantees": {
          "type": "boolean"
        },
        "recordSourceAndReviewDateForTimeSensitiveData": {
          "type": "boolean"
        },
        "minimizePersonalDataCollection": {
          "type": "boolean"
        },
        "documentRetentionAndDeletionPractices": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "manifestValidation": {
      "type": "object",
      "required": [
        "format",
        "encoding",
        "commentsAllowed",
        "trailingCommasAllowed",
        "requireUniqueAreaIds",
        "requireUniqueCollectionIds",
        "pathsMustBeRepositoryRelative",
        "pathSeparators",
        "verifyParentDirectoryBeforeAddingFile",
        "nestedManifestPathsMustBeConsistent",
        "statusMustReflectVerification",
        "manifestMustNotClaimUnverifiedFilesExist",
        "schemaPath",
        "validationMustRunBeforeMerge"
      ],
      "properties": {
        "format": {
          "const": "JSON"
        },
        "encoding": {
          "const": "UTF-8"
        },
        "commentsAllowed": {
          "const": false
        },
        "trailingCommasAllowed": {
          "const": false
        },
        "requireUniqueAreaIds": {
          "type": "boolean"
        },
        "requireUniqueCollectionIds": {
          "type": "boolean"
        },
        "pathsMustBeRepositoryRelative": {
          "type": "boolean"
        },
        "verifyParentDirectoryBeforeAddingFile": {
          "type": "boolean"
        },
        "nestedManifestPathsMustBeConsistent": {
          "type": "boolean"
        },
        "statusMustReflectVerification": {
          "type": "boolean"
        },
        "manifestMustNotClaimUnverifiedFilesExist": {
          "type": "boolean"
        },
        "pathSeparators": {
          "const": "forward-slash"
        },
        "schemaPath": {
          "$ref": "#/$defs/repositoryPath"
        },
        "validationMustRunBeforeMerge": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "maintenance": {
      "type": "object",
      "required": [
        "maintainedBy",
        "updateWhenProjectStructureChanges",
        "verifyPathsBeforeMarkingExisting",
        "keepNestedManifestsConsistent",
        "reviewSecurityAndDeploymentDocumentation",
        "reviewRuntimeVersionAndDependencies",
        "reviewManifestChangesInPullRequests"
      ],
      "properties": {
        "maintainedBy": {
          "type": "string"
        },
        "updateWhenProjectStructureChanges": {
          "type": "boolean"
        },
        "verifyPathsBeforeMarkingExisting": {
          "type": "boolean"
        },
        "keepNestedManifestsConsistent": {
          "type": "boolean"
        },
        "reviewSecurityAndDeploymentDocumentation": {
          "type": "boolean"
        },
        "reviewRuntimeVersionAndDependencies": {
          "type": "boolean"
        },
        "reviewManifestChangesInPullRequests": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schemaFile": {
      "$ref": "#/$defs/repositoryPath"
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "planned",
        "existing",
        "deprecated",
        "missing",
        "ignored"
      ]
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "inventoryItem": {
      "type": "object",
      "required": [
        "path",
        "purpose",
        "status"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      },
      "additionalProperties": false
    }
  }
}
