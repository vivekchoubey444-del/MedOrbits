  "metadata": {
    "title": "MedOrbits Entrance Examinations Catalogue",
    "description": "Catalogue of entrance and related examinations for health courses. IDs match exams.json and courses.json.",
    "defaultCountryCode": "IN",
    "dateFormat": "YYYY-MM-DD",
    "verificationPolicy": "Verify authority, eligibility, dates and links against the official examination authority before publication. Never invent them."
  },
  "fields": [
    "id",
    "name",
    "shortName",
    "slug",
    "aliases",
    "countryCode",
    "examPurpose",
    "examLevel",
    "conductingAuthority",
    "courseIds",
    "officialUrl",
    "sourceUrl",
    "description",
    "frequency",
    "examMode",
    "currentCycle",
    "verificationStatus",
    "verifiedAt",
    "verifiedBy",
    "reviewDueAt",
    "sortOrder",
    "active",
    "createdAt",
    "updatedAt"
  ],
  "allowedValues": {
    "examPurpose": [
      "admission",
      "licensing",
      "scholarship",
      "other"
    ],
    "examLevel": [
      "national",
      "state",
      "institutional",
      "international",
      "other"
    ],
    "frequency": [
      "annual",
      "biannual",
      "multiple_per_year",
      "irregular",
      "unknown"
    ],
    "examMode": [
      "computer_based",
      "pen_and_paper",
      "hybrid",
      "unknown"
    ],
    "verificationStatus": [
      "unverified",
      "pending_review",
      "verified",
      "outdated",
      "rejected"
    ]
  },
  "dataRules": [
    "id and slug must be unique; ids must match exams.json where the same exam appears.",
    "Every value in courseIds must reference an existing course in courses.json.",
    "countryCode must be an ISO 3166-1 alpha-2 code.",
    "examPurpose 'licensing' means the test is not an admission test and must not be presented as one.",
    "officialUrl, frequency, examMode and all currentCycle values must stay null until taken from an official source.",
    "conductingAuthority is informational and must be re-verified each cycle because it can change.",
    "currentCycle dates use YYYY-MM-DD; examDate must not precede registrationStart when both are set.",
    "Placeholder entries (state, institution, other) must stay unverified and must not be shown as official.",
    "verifiedAt and verifiedBy must be null until verified, and set together; 'verified' also requires sourceUrl.",
    "The active field controls display only; it does not mean registration is open.",
    "Never invent dates, eligibility, links or authority details."
  ],
