{
  "schemaVersion": "1.0.0",
  "updatedAt": null,
  "metadata": {
    "title": "MedOrbits Jobs Database",
    "description": "Structured information on job openings and career roles related to health courses. Details are added only from official or employer sources.",
    "defaultCountryCode": "IN",
    "defaultCurrency": "INR",
    "dateFormat": "YYYY-MM-DD",
    "verificationPolicy": "Verify the employer, vacancy, eligibility, pay and deadlines against the official recruitment notice before publication."
  },
  "fields": [
    "id", "title", "slug", "employerName", "employerType", "institutionId", "courseIds",
    "jobType", "employmentType", "department", "location", "countryCode", "vacancies",
    "eligibilitySummary", "eligibilitySourceUrl", "experienceRequired", "registrationRequirement",
    "payMin", "payMax", "payCurrency", "payFrequency", "payNotes",
    "applicationStart", "applicationEnd", "applicationStatus", "applicationUrl",
    "noticeTitle", "noticeDate", "noticeUrl", "officialUrl", "sourceUrl", "notes",
    "verificationStatus", "verifiedAt", "verifiedBy", "reviewDueAt",
    "active", "createdAt", "updatedAt"
  ],
  "fieldDefinitions": {
    "id": { "type": "string", "required": true, "unique": true, "example": "job-employer-role-2026" },
    "title": { "type": "string", "required": true },
    "slug": { "type": "string", "required": true, "unique": true, "format": "kebab-case" },
    "employerName": { "type": "string", "required": true },
    "employerType": { "type": "string", "required": false, "nullable": true, "enum": "allowedValues.employerType" },
    "institutionId": { "type": "string", "required": false, "nullable": true, "references": "institutions.id" },
    "courseIds": { "type": "array", "required": false, "default": [], "references": "courses.id", "note": "Courses whose graduates may be relevant; not a guarantee of eligibility." },
    "jobType": { "type": "string", "required": true, "enum": "allowedValues.jobType" },
    "employmentType": { "type": "string", "required": false, "nullable": true, "enum": "allowedValues.employmentType" },
    "department": { "type": "string", "required": false, "nullable": true },
    "location": { "type": "object", "required": false, "nullable": true, "shape": { "city": "string or null", "state": "string or null", "remote": "boolean or null" } },
    "countryCode": { "type": "string", "required": true, "format": "ISO 3166-1 alpha-2" },
    "vacancies": { "type": "integer", "required": false, "nullable": true },
    "eligibilitySummary": { "type": "string", "required": false, "nullable": true, "maxLength": 1000 },
    "eligibilitySourceUrl": { "type": "string", "required": false, "nullable": true, "format": "https URL" },
    "experienceRequired": { "type": "string", "required": false, "nullable": true },
    "registrationRequirement": { "type": "string", "required": false, "nullable": true, "note": "Professional registration or licence requirement as stated in the official notice." },
    "payMin": { "type": "number", "required": false, "nullable": true },
    "payMax": { "type": "number", "required": false, "nullable": true },
    "payCurrency": { "type": "string", "required": false, "nullable": true, "format": "ISO 4217" },
    "payFrequency": { "type": "string", "required": false, "nullable": true, "enum": "allowedValues.payFrequency" },
    "payNotes": { "type": "string", "required": false, "nullable": true },
    "applicationStart": { "type": "string", "required": false, "nullable": true, "format": "YYYY-MM-DD" },
    "applicationEnd": { "type": "string", "required": false, "nullable": true, "format": "YYYY-MM-DD" },
    "applicationStatus": { "type": "string", "required": true, "enum": "allowedValues.applicationStatus", "default": "awaiting_notification" },
    "applicationUrl": { "type": "string", "required": false, "nullable": true, "format": "https URL" },
    "noticeTitle": { "type": "string", "required": false, "nullable": true },
    "noticeDate": { "type": "string", "required": false, "nullable": true, "format": "YYYY-MM-DD" },
    "noticeUrl": { "type": "string", "required": false, "nullable": true, "format": "https URL" },
    "officialUrl": { "type": "string", "required": false, "nullable": true, "format": "https URL" },
    "sourceUrl": { "type": "string", "required": false, "nullable": true, "format": "https URL" },
    "notes": { "type": "string", "required": false, "nullable": true, "note": "Internal reviewer notes; never shown publicly." },
    "verificationStatus": { "type": "string", "required": true, "enum": "allowedValues.verificationStatus", "default": "unverified" },
    "verifiedAt": { "type": "string", "required": false, "nullable": true, "format": "YYYY-MM-DD" },
    "verifiedBy": { "type": "string", "required": false, "nullable": true },
    "reviewDueAt": { "type": "string", "required": false, "nullable": true, "format": "YYYY-MM-DD" },
    "active": { "type": "boolean", "required": true, "default": true },
    "createdAt": { "type": "string", "required": false, "nullable": true, "format": "ISO 8601 datetime" },
    "updatedAt": { "type": "string", "required": false, "nullable": true, "format": "ISO 8601 datetime" }
  },
  "allowedValues": {
    "employerType": ["government", "public_sector", "private_hospital", "private_company", "academic_institution", "research_organisation", "ngo", "armed_forces", "other"],
    "jobType": ["clinical", "teaching", "research", "administrative", "technical", "public_health", "pharma_industry", "other"],
    "employmentType": ["full_time", "part_time", "contract", "temporary", "internship", "fellowship", "other"],
    "payFrequency": ["monthly", "annual", "hourly", "other"],
    "applicationStatus": ["upcoming", "open", "closed", "extended", "awaiting_notification", "not_applicable"],
    "verificationStatus": ["unverified", "pending_review", "verified", "outdated", "rejected"]
  },
  "dataRules": [
    "Every job record must have a unique id and slug.",
    "countryCode must be an ISO 3166-1 alpha-2 code.",
    "courseIds and institutionId, when set, must reference existing records.",
    "Never invent vacancies, pay, eligibility, registration requirements, dates or employer details; use null when unknown.",
    "Only publish a job from an official recruitment notice or the employer's own channel; noticeUrl or sourceUrl is required for verification.",
    "payMax must not be below payMin when both are set; payMin and payMax require payCurrency and payFrequency.",
    "applicationEnd must not precede applicationStart when both are provided.",
    "Dates must use YYYY-MM-DD or null.",
    "registrationRequirement must state only what the notice states; never infer licensing rules.",
    "Never present a job as guaranteed, and never imply that listing it means the person is eligible.",
    "Never collect or display unnecessary personal data in job records.",
    "Closed or expired postings must be reviewed before being displayed as current.",
    "verifiedAt and verifiedBy must be null until verified, and set together; 'verified' requires sourceUrl or noticeUrl.",
    "The active field controls display only; it does not indicate that applications are open."
  ],
  "displayRules": {
    "alwaysShow": ["verificationStatus", "applicationEnd"],
    "hideFromPublicWhen": ["active == false", "verificationStatus == 'rejected'"],
    "showStaleWarningWhen": ["applicationEnd < today", "reviewDueAt < today", "verificationStatus == 'outdated'"],
    "unverifiedLabel": "Unverified - confirm this vacancy with the official notice or employer.",
    "disclaimer": "Listings are informational and do not guarantee employment or eligibility. Always apply through the official employer channel and beware of anyone asking for fees to secure a job."
  },
  "jobs": []
}
