{
  "schemaVersion": "1.0.0",
  "updatedAt": null,
  "metadata": {
    "title": "MedOrbits Hostels Database",
    "description": "Structured hostel and accommodation information for institutions. Details are added only from official sources.",
    "defaultCountryCode": "IN",
    "defaultCurrency": "INR",
    "verificationPolicy": "Verify availability, rules, facilities and charges with the institution or official hostel notice before publication."
  },
  "fields": [
    "id", "institutionId", "name", "slug", "countryCode", "hostelType", "genderPolicy",
    "campusLocation", "address", "city", "state", "roomTypes", "facilities", "foodOptions",
    "capacity", "feeIds", "allotmentProcess", "rulesSummary", "contactEmail", "contactPhone",
    "officialUrl", "sourceUrl", "verificationStatus", "verifiedAt", "verifiedBy", "reviewDueAt",
    "active", "createdAt", "updatedAt"
  ],
  "fieldDefinitions": {
    "id": { "type": "string", "required": true, "unique": true, "example": "hostel-institution-name" },
    "institutionId": { "type": "string", "required": true, "references": "institutions.id" },
    "name": { "type": "string", "required": true },
    "slug": { "type": "string", "required": true, "unique": true, "format": "kebab-case" },
    "countryCode": { "type": "string", "required": true, "format": "ISO 3166-1 alpha-2" },
    "hostelType": { "type": "string", "required": false, "nullable": true, "enum": "allowedValues.hostelType" },
    "genderPolicy": { "type": "string", "required": false, "nullable": true, "enum": "allowedValues.genderPolicy" },
    "campusLocation": { "type": "string", "required": false, "nullable": true, "enum": "allowedValues.campusLocation" },
    "address": { "type": "string", "required": false, "nullable": true },
    "city": { "type": "string", "required": false, "nullable": true },
    "state": { "type": "string", "required": false, "nullable": true },
    "roomTypes": { "type": "array", "required": false, "default": [], "itemEnum": "allowedValues.roomType" },
    "facilities": { "type": "array", "required": false, "default": [], "itemEnum": "allowedValues.facility" },
    "foodOptions": { "type": "array", "required": false, "default": [], "itemEnum": "allowedValues.foodOption" },
    "capacity": { "type": "integer", "required": false, "nullable": true },
    "feeIds": { "type": "array", "required": false, "default": [], "references": "fees.id" },
    "allotmentProcess": { "type": "string", "required": false, "nullable": true },
    "rulesSummary": { "type": "string", "required": false, "nullable": true },
    "contactEmail": { "type": "string", "required": false, "nullable": true, "format": "email" },
    "contactPhone": { "type": "string", "required": false, "nullable": true },
    "officialUrl": { "type": "string", "required": false, "nullable": true, "format": "https URL" },
    "sourceUrl": { "type": "string", "required": false, "nullable": true, "format": "https URL" },
    "verificationStatus": { "type": "string", "required": true, "enum": "allowedValues.verificationStatus", "default": "unverified" },
    "verifiedAt": { "type": "string", "required": false, "nullable": true, "format": "YYYY-MM-DD" },
    "verifiedBy": { "type": "string", "required": false, "nullable": true },
    "reviewDueAt": { "type": "string", "required": false, "nullable": true, "format": "YYYY-MM-DD" },
    "active": { "type": "boolean", "required": true, "default": true },
    "createdAt": { "type": "string", "required": false, "nullable": true, "format": "ISO 8601 datetime" },
    "updatedAt": { "type": "string", "required": false, "nullable": true, "format": "ISO 8601 datetime" }
  },
  "allowedValues": {
    "hostelType": ["university", "institution", "private", "government", "off_campus_partner", "other"],
    "genderPolicy": ["boys", "girls", "co_ed", "separate_blocks", "not_specified"],
    "campusLocation": ["on_campus", "off_campus", "not_specified"],
    "roomType": ["single", "double", "triple", "dormitory", "apartment", "other"],
    "facility": [
      "wifi",
      "mess",
      "laundry",
      "study_room",
      "common_room",
      "gym",
      "medical_room",
      "security",
      "cctv",
      "power_backup",
      "water_purifier",
      "air_conditioning",
      "parking",
      "transport",
      "other"
    ],
    "foodOption": ["vegetarian", "non_vegetarian", "vegan", "jain", "self_cooking", "no_mess"],
    "verificationStatus": ["unverified", "pending_review", "verified", "outdated", "rejected"]
  },
  "dataRules": [
    "Every hostel record must have a unique id and slug.",
    "institutionId must reference an existing institution record.",
    "feeIds, when set, must reference existing fee records with a hostel component.",
    "countryCode must be an ISO 3166-1 alpha-2 code.",
    "Never invent facilities, capacity, rules, contact details or availability; use null or an empty list when unknown.",
    "A listed hostel does not guarantee a room; allotment depends on the institution's policy.",
    "Contact details must come from the institution's official channels.",
    "officialUrl must be https and point to the institution or its official hostel page.",
    "verifiedAt and verifiedBy must be null until verified, and set together; 'verified' requires sourceUrl.",
    "Unverified records must be labelled as unverified when displayed.",
    "Safety, medical and anti-ragging information must be taken from official institutional or regulatory sources.",
    "The active field controls display only."
  ],
  "displayRules": {
    "alwaysShow": ["verificationStatus"],
    "unverifiedLabel": "Unverified - confirm hostel availability and rules with the institution.",
    "disclaimer": "Hostel details can change and availability is not guaranteed. Confirm with the institution before making decisions or payments."
  },
  "hostels": []
}
