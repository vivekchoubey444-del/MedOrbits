{
  "schemaVersion": "1.0.0",
  "updatedAt": null,
  "metadata": {
    "title": "MedOrbits Health Sectors",
    "description": "Career and study sectors within health and life sciences, linking courses, job types and employer types. Seed descriptions are general and must not be read as guarantees.",
    "defaultCountryCode": "IN",
    "defaultLanguage": "en",
    "note": "Sector groupings are editorial. A course may belong to several sectors. Salary, demand and regulatory details stay null until sourced."
  },
  "fields": [
    "id",
    "name",
    "slug",
    "description",
    "courseIds",
    "jobTypes",
    "employerTypes",
    "exampleRoles",
    "keySkills",
    "careerStages",
    "relatedCategories",
    "relatedFaqIds",
    "regulatoryNote",
    "salaryInfo",
    "demandInfo",
    "sourceUrl",
    "icon",
    "sortOrder",
    "featured",
    "verificationStatus",
    "verifiedAt",
    "verifiedBy",
    "reviewDueAt",
    "active",
    "createdAt",
    "updatedAt"
  ],
  "fieldDefinitions": {
    "courseIds": {
      "type": "array",
      "references": "courses.id",
      "note": "Courses that commonly lead into this sector; not a guarantee of eligibility or employment."
    },
    "jobTypes": {
      "type": "array",
      "itemEnum": "jobs.allowedValues.jobType"
    },
    "employerTypes": {
      "type": "array",
      "itemEnum": "jobs.allowedValues.employerType"
    },
    "careerStages": {
      "type": "array",
      "itemShape": {
        "stage": "string",
        "description": "string",
        "typicalCourseIds": "array of courses.id"
      },
      "note": "Sourced, general descriptions only."
    },
    "salaryInfo": {
      "type": "object",
      "nullable": true,
      "shape": {
        "currency": "ISO 4217",
        "min": "number",
        "max": "number",
        "frequency": "enum",
        "year": "integer",
        "sourceUrl": "https URL"
      },
      "note": "Only from a published official source with year; never estimated."
    },
    "demandInfo": {
      "type": "object",
      "nullable": true,
      "shape": {
        "summary": "string",
        "year": "integer",
        "sourceUrl": "https URL"
      },
      "note": "Only from a published source; never speculative."
    },
    "regulatoryNote": {
      "type": "string",
      "required": true
    }
  },
  "allowedValues": {
    "verificationStatus": [
      "unverified",
      "pending_review",
      "verified",
      "outdated",
      "rejected"
    ]
  },
  "dataRules": [
    "id and slug must be unique; slug is lowercase kebab-case.",
    "Every courseId must exist in courses.json; jobTypes and employerTypes must use values defined in jobs.json.",
    "A course may appear in multiple sectors; sector membership never implies eligibility, recognition or employment.",
    "Never invent salaries, demand figures, growth rates or placement statistics; salaryInfo and demandInfo stay null until sourced with a year.",
    "Descriptions must stay general and must not promise outcomes.",
    "regulatoryNote must always point users to the relevant official regulator rather than stating rules from memory.",
    "verifiedAt and verifiedBy must be null until verified, and set together.",
    "The active field controls display only."
  ],
  "displayRules": {
    "alwaysShow": [
      "regulatoryNote"
    ],
    "unverifiedLabel": "Unverified - confirm pathways and requirements with official sources.",
    "disclaimer": "Sector overviews are general guidance, not career advice or a guarantee of jobs, income or admission."
  },
