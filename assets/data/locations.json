{
  "schemaVersion": "1.0.0",
  "updatedAt": null,
  "metadata": {
    "title": "MedOrbits Locations Database",
    "description": "Hierarchical locations (countries, states or union territories, cities) used by institutions, hostels, jobs and admissions.",
    "defaultCountryCode": "IN",
    "hierarchy": [
      "country",
      "state",
      "city"
    ],
    "standards": {
      "country": "ISO 3166-1 alpha-2",
      "subdivision": "ISO 3166-2",
      "currency": "ISO 4217"
    },
    "verificationPolicy": "Names and codes follow ISO standards. Verify administrative changes (new states, renamed cities, merged territories) before publication. Never invent locations or details."
  },
  "fields": {
    "countries": [
      "id",
      "name",
      "slug",
      "countryCode",
      "continent",
      "currencyCode",
      "regulatorNote",
      "officialUrl",
      "sourceUrl",
      "studyAbroadListed",
      "sortOrder",
      "verificationStatus",
      "verifiedAt",
      "verifiedBy",
      "active",
      "createdAt",
      "updatedAt"
    ],
    "states": [
      "id",
      "name",
      "slug",
      "countryCode",
      "stateCode",
      "type",
      "capitalCity",
      "officialUrl",
      "sourceUrl",
      "sortOrder",
      "verificationStatus",
      "verifiedAt",
      "verifiedBy",
      "active",
      "createdAt",
      "updatedAt"
    ],
    "cities": [
      "id",
      "name",
      "slug",
      "countryCode",
      "stateId",
      "stateCode",
      "district",
      "pincode",
      "latitude",
      "longitude",
      "timezone",
      "medicalHub",
      "sortOrder",
      "sourceUrl",
      "verificationStatus",
      "verifiedAt",
      "verifiedBy",
      "active",
      "createdAt",
      "updatedAt"
    ]
  },
  "fieldDefinitions": {
    "countries.countryCode": {
      "type": "string",
      "required": true,
      "unique": true,
      "format": "ISO 3166-1 alpha-2"
    },
    "countries.continent": {
      "type": "string",
      "enum": "allowedValues.continent"
    },
    "countries.studyAbroadListed": {
      "type": "boolean",
      "default": false,
      "note": "True only if MedOrbits chooses to show this country in study-abroad content; it does not imply recognition of any institution."
    },
    "states.stateCode": {
      "type": "string",
      "required": true,
      "unique": true,
      "format": "ISO 3166-2, e.g. IN-MH"
    },
    "states.type": {
      "type": "string",
      "enum": "allowedValues.subdivisionType"
    },
    "cities.stateId": {
      "type": "string",
      "required": false,
      "nullable": true,
      "references": "states.id"
    },
    "cities.pincode": {
      "type": "string",
      "required": false,
      "nullable": true,
      "format": "6 digits for India"
    },
    "cities.latitude": {
      "type": "number",
      "required": false,
      "nullable": true,
      "range": [
        -90,
        90
      ]
    },
    "cities.longitude": {
      "type": "number",
      "required": false,
      "nullable": true,
      "range": [
        -180,
        180
      ]
    },
    "cities.timezone": {
      "type": "string",
      "required": false,
      "nullable": true,
      "format": "IANA timezone, e.g. Asia/Kolkata"
    },
    "cities.medicalHub": {
      "type": "boolean",
      "required": false,
      "nullable": true,
      "note": "Editorial flag; set only with a documented basis."
    }
  },
  "allowedValues": {
    "continent": [
      "asia",
      "europe",
      "africa",
      "north_america",
      "south_america",
      "oceania",
      "antarctica"
    ],
    "subdivisionType": [
      "state",
      "union_territory",
      "province",
      "region",
      "other"
    ],
    "verificationStatus": [
      "unverified",
      "pending_review",
      "verified",
      "outdated",
      "rejected"
    ]
  },
  "dataRules": [
    "id, slug and codes must be unique within their collection; slugs are lowercase kebab-case.",
    "countryCode must be ISO 3166-1 alpha-2 and exist in countries; stateCode must follow ISO 3166-2.",
    "Every city must reference an existing country, and a state when one applies (stateId must match the city's countryCode).",
    "Use the official administrative name; keep alternate or former names out of name and add them to notes or aliases only when verified.",
    "Latitude and longitude must be decimal degrees within valid ranges, or null.",
    "Never invent capitals, districts, pincodes, coordinates or timezones; leave null until verified.",
    "A country being listed does not imply that its institutions are recognised for practice in India; recognition must come from the relevant regulator.",
    "Administrative changes (merged territories, renamed cities) must be reviewed before the data is displayed as current.",
    "verifiedAt and verifiedBy must be null until verified, and set together.",
    "The active field controls display only."
  ],
