{
  "schemaVersion": "1.1.0",
  "updatedAt": null,
  "metadata": {
    "title": "MedOrbits Courses Database",
    "description": "Courses referenced by exams and admission records.",
    "defaultCountryCode": "IN",
    "verificationPolicy": "Verify course details (duration, regulator, eligibility) against the current official regulator before publication. Never invent details."
  },
  "fields": [
    "id",
    "name",
    "shortName",
    "slug",
    "aliases",
    "level",
    "discipline",
    "countryCode",
    "regulatorName",
    "regulatorUrl",
    "examIds",
    "durationYears",
    "internshipIncluded",
    "description",
    "tags",
    "sortOrder",
    "sourceUrl",
    "verificationStatus",
    "verifiedAt",
    "verifiedBy",
    "reviewDueAt",
    "active",
    "createdAt",
    "updatedAt"
  ],
  "allowedValues": {
    "level": [
      "undergraduate",
      "postgraduate",
      "doctoral",
      "diploma",
      "certificate",
      "other"
    ],
    "discipline": [
      "medicine",
      "dentistry",
      "nursing",
      "pharmacy",
      "allied_health",
      "ayush",
      "veterinary",
      "other"
    ],
    "verificationStatus": [
      "unverified",
      "pending_review",
      "verified",
      "outdated",
      "rejected"
    ]
  },
  "dataRules": [
    "id and slug must be unique across all courses; slug must be lowercase kebab-case.",
    "countryCode must be an ISO 3166-1 alpha-2 code, or null for courses not tied to one country.",
    "Every value in examIds must reference an existing exam record, and that exam's courseIds should include this course.",
    "examIds may be empty when admission is not through a national exam or the exam has not yet been verified.",
    "durationYears, regulatorName, regulatorUrl and sourceUrl must be null until verified from an official source.",
    "regulatorUrl must be https and point to the authoritative regulator.",
    "verifiedAt and verifiedBy must be null until actually verified, and set together.",
    "verificationStatus 'verified' requires verifiedAt, verifiedBy and sourceUrl.",
    "Listing a course here does not mean admissions are open; the active field controls display only.",
    "Never invent durations, eligibility, regulators or links."
  ],
