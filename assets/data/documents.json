{
  "schemaVersion": "1.0.0",
  "updatedAt": null,
  "metadata": {
    "title": "MedOrbits Admission Documents Database",
    "description": "Catalogue of documents commonly requested during admissions. Requirements for a specific admission must come from its official notification.",
    "defaultCountryCode": "IN",
    "verificationPolicy": "Entries describe commonly requested document types only. Do not present any document as mandatory for a specific admission until verified against the official notification."
  },
  "fields": [
    "id",
    "name",
    "slug",
    "category",
    "description",
    "applicableAdmissionTypes",
    "courseIds",
    "originalRequired",
    "attestationRequired",
    "acceptedFormats",
    "maxFileSizeKb",
    "guidanceUrl",
    "sourceUrl",
    "verificationStatus",
    "verifiedAt",
    "verifiedBy",
    "reviewDueAt",
    "sortOrder",
    "active",
    "createdAt",
    "updatedAt"
  ],
  "allowedValues": {
    "category": [
      "exam",
      "counselling",
      "academic",
      "identity",
      "eligibility",
      "medical",
      "financial",
      "application",
      "regulatory",
      "legal",
      "other"
    ],
    "applicableAdmissionTypes": [
      "entrance_exam",
      "merit_based",
      "counselling",
      "direct_application",
      "international_admission",
      "other"
    ],
    "verificationStatus": [
      "unverified",
      "pending_review",
      "verified",
      "outdated",
      "rejected"
    ]
  },
  "dataRules": [
    "id and slug must be unique; slug must be lowercase kebab-case.",
    "applicableAdmissionTypes must use values from allowedValues and match admissionType in the admissions data.",
    "courseIds is optional; an empty list means the document is not limited to specific courses. Every value must reference an existing course.",
    "originalRequired, attestationRequired, acceptedFormats, maxFileSizeKb and guidanceUrl must stay null or empty until taken from an official source.",
    "A document being listed here does not mean it is required for any particular admission.",
    "verifiedAt and verifiedBy must be null until verified, and set together.",
    "verificationStatus 'verified' requires verifiedAt, verifiedBy and sourceUrl.",
    "Never invent format, size, attestation or eligibility requirements."
  ],
