{
  "name": "medorbits",
  "version": "1.0.0",
  "private": true,
  "description": "MedOrbits - Education consultancy, admissions guidance, career opportunities, recruitment and student services platform.",
  "author": "MedOrbits",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "start:production": "cross-env NODE_ENV=production node server.js",
    "check:node": "node --version",
    "check:env": "node scripts/check-env.js",
    "check:data": "node scripts/validate-data.js",
    "check:health": "node scripts/health-check.js",
    "lint": "eslint . --ignore-pattern node_modules --ignore-pattern storage --ignore-pattern coverage",
    "lint:fix": "eslint . --fix --ignore-pattern node_modules --ignore-pattern storage --ignore-pattern coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "test:unit": "jest --runInBand tests/unit",
    "test:integration": "jest --runInBand tests/integration",
    "test:api": "jest --runInBand tests/api",
    "test:security": "jest --runInBand tests/security",
    "test:e2e": "jest --runInBand tests/e2e",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "security:audit": "npm audit",
    "security:audit:fix": "npm audit fix",
    "prepare": "husky"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "connect-mongo": "^5.1.0",
    "connect-redis": "^8.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "mysql2": "^3.14.4",
    "nodemailer": "^7.0.5",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.1",
    "rate-limit-redis": "^4.2.1",
    "redis": "^5.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "cross-env": "^10.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/*.test.js",
      "**/*.spec.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.config.js",
      "!src/**/index.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "clearMocks": true,
    "restoreMocks": true
  },
  "prettier": {
    "singleQuote": true,
    "semi": true,
    "trailingComma": "all",
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf"
  }
}