
# EditorConfig configuration for MedOrbits
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{js,cjs,mjs,jsx,ts,tsx,json,yml,yaml}]
indent_style = space
indent_size = 2

[*.{html,htm,css,scss,less,xml,svg}]
indent_style = space
indent_size = 2

[*.{sh,bash}]
indent_style = space
indent_size = 2
end_of_line = lf

[Makefile]
indent_style = tab

[*.{py,pyi}]
indent_style = space
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf

[*.{jpg,jpeg,png,gif,webp,ico,pdf,zip}]
insert_final_newline = false
trim_trailing_whitespace = false

[.env*]
insert_final_newline = true
