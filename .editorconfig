EditorConfig configuration for MedOrbits

https://editorconfig.org

Keep formatting consistent across editors, operating systems, and contributors.

root = true

Default rules for text files

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

Markdown and documentation

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
max_line_length = off

JavaScript and TypeScript

[*.{js,cjs,mjs,jsx,ts,tsx,mts,cts}]
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true

JSON and JSON-based configuration

[*.{json,jsonc,json5}]
indent_style = space
indent_size = 2
end_of_line = lf

YAML configuration and workflows

[*.{yml,yaml}]
indent_style = space
indent_size = 2
end_of_line = lf

HTML, templates, stylesheets, and vector graphics

[*.{html,htm,css,scss,sass,less,xml,svg}]
indent_style = space
indent_size = 2
end_of_line = lf

Shell scripts

[*.{sh,bash}]
indent_style = space
indent_size = 2
end_of_line = lf

Python

[*.{py,pyi}]
indent_style = space
indent_size = 4
end_of_line = lf

SQL and database migrations

[*.sql]
indent_style = space
indent_size = 2
end_of_line = lf

TOML, INI, and environment configuration

[*.{toml,ini,conf}]
indent_style = space
indent_size = 2
end_of_line = lf

Makefiles require tabs for recipe indentation

[Makefile]
indent_style = tab
end_of_line = lf

Windows command scripts

[*.{bat,cmd}]
end_of_line = crlf
insert_final_newline = true

Environment files

[.env*]
insert_final_newline = true
trim_trailing_whitespace = true

Lockfiles and package-manager metadata

[package-lock.json]
indent_style = space
indent_size = 2

[yarn.lock]
indent_style = space
indent_size = 2

[pnpm-lock.yaml]
indent_style = space
indent_size = 2

Binary and generated assets: do not apply text-file formatting rules

[*.{jpg,jpeg,png,gif,webp,ico,pdf,zip,woff,woff2,ttf,eot,mp4,webm,mp3,sqlite,db}]
insert_final_newline = unset
trim_trailing_whitespace = unset
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset