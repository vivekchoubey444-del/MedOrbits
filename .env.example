
# =============================================================================
# MedOrbits -- Environment Configuration
# File: .env.example
# Copy to: .env
# =============================================================================
# SECURITY:
# 1. Never commit .env or production credentials.
# 2. Replace all example credentials before deployment.
# 3. Keep private uploads outside public/ and web-accessible directories.
# 4. Use HTTPS, secure cookies, strong secrets and database TLS in production.
# 5. Configure only the integrations your deployment actually uses.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. APPLICATION AND SERVER
# -----------------------------------------------------------------------------

NODE_ENV=development
APP_ENV=development
APP_NAME=MedOrbits

APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api/v1
API_PREFIX=/api/v1

HOST=127.0.0.1
PORT=3000
TRUST_PROXY=0

APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en-IN
APP_CURRENCY=INR

PUBLIC_DEFAULT_LOCALE=en-IN
PUBLIC_DEFAULT_CURRENCY=INR
PUBLIC_BRAND_NAME=MedOrbits

APP_SUPPORT_EMAIL=support@example.com
APP_CONTACT_EMAIL=contact@example.com
APP_LEGAL_EMAIL=legal@example.com

MAINTENANCE_MODE=false


# -----------------------------------------------------------------------------
# 2. SECURITY, AUTHENTICATION AND SESSIONS
# -----------------------------------------------------------------------------
# Development placeholders only. Generate independent random secrets for .env.
# For example, use: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

SESSION_SECRET=replace_with_a_random_development_session_secret
JWT_SECRET=replace_with_a_random_development_jwt_secret
COOKIE_SECRET=replace_with_a_random_development_cookie_secret

JWT_ISSUER=medorbits
JWT_AUDIENCE=medorbits-users
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
JWT_ALGORITHM=HS256

BCRYPT_ROUNDS=12

CSRF_ENABLED=true

COOKIE_NAME=medorbits.sid
COOKIE_HTTP_ONLY=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

REQUEST_BODY_LIMIT=1mb
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb

HELMET_ENABLED=true
CONTENT_SECURITY_POLICY_ENABLED=true
TLS_REJECT_UNAUTHORIZED=true

AUTH_ENABLED=true
REGISTRATION_ENABLED=true
EMAIL_VERIFICATION_REQUIRED=true
PHONE_VERIFICATION_REQUIRED=false
MFA_ENABLED=false

PASSWORD_MIN_LENGTH=12
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24


# -----------------------------------------------------------------------------
# 3. MYSQL DATABASE
# -----------------------------------------------------------------------------
# Requires a compatible MySQL server and mysql2/promise in the backend.
# Create the database and application user separately before starting the app.
# Do not use a database administrator account for routine application queries.

DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=medorbits
DB_USER=medorbits_app
DB_PASSWORD=change_me_local_only
DATABASE_URL=

DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT=10000
DB_IDLE_TIMEOUT=60000

DB_WAIT_FOR_CONNECTIONS=true
DB_ENABLE_KEEPALIVE=true
DB_TIMEZONE=Z
DB_LOG_QUERIES=false

DB_AUTO_MIGRATE=false
DB_AUTO_SEED=false

DB_SSL_ENABLED=false
DB_SSL_CA_PATH=
DB_SSL_CERT_PATH=
DB_SSL_KEY_PATH=

DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=


# -----------------------------------------------------------------------------
# 4. REDIS, CACHE AND RATE-LIMIT STORAGE
# -----------------------------------------------------------------------------

REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=
REDIS_TLS_ENABLED=false
REDIS_CONNECT_TIMEOUT=10000
REDIS_KEY_PREFIX=medorbits:

SESSION_STORE=memory
SESSION_TTL_SECONDS=604800

CACHE_ENABLED=false
CACHE_TTL_SECONDS=300
RATE_LIMIT_STORE=memory


# -----------------------------------------------------------------------------
# 5. CORS
# -----------------------------------------------------------------------------
# Use comma-separated, explicit origins without trailing slashes.
# Example: https://medorbits.in,https://www.medorbits.in

CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE_SECONDS=600


# -----------------------------------------------------------------------------
# 6. EMAIL AND SMTP
# -----------------------------------------------------------------------------

EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_CONNECTION_TIMEOUT_MS=10000

EMAIL_FROM_NAME=MedOrbits
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_REPLY_TO=support@example.com
EMAIL_SEND_TIMEOUT_MS=15000
EMAIL_MAX_RETRIES=3

EMAIL_VERIFICATION_URL=http://localhost:3000/account/verify-email.html
PASSWORD_RESET_URL=http://localhost:3000/account/reset-password.html

RESEND_API_KEY=
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=


# -----------------------------------------------------------------------------
# 7. UPLOADS AND PRIVATE DOCUMENT STORAGE
# -----------------------------------------------------------------------------
# Never expose storage/private through express.static().
# Validate actual file signatures in addition to MIME types and file extensions.

UPLOADS_ENABLED=true
STORAGE_DRIVER=local

STORAGE_LOCAL_PATH=storage/private
STORAGE_TEMP_PATH=storage/temporary

UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_MAX_FILES=10
UPLOAD_MAX_TOTAL_SIZE_MB=50

UPLOAD_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png

PRIVATE_DOCUMENTS_ENABLED=true
DOCUMENTS_REQUIRE_AUTHENTICATION=true
DOCUMENTS_REQUIRE_AUTHORIZATION=true

TEMP_FILE_TTL_HOURS=24
UPLOAD_CLEANUP_ENABLED=true

MALWARE_SCAN_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# S3-compatible storage. Leave disabled for local storage.
S3_ENABLED=false
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=


# -----------------------------------------------------------------------------
# 8. PAYMENTS
# -----------------------------------------------------------------------------
# Keep payments disabled until a provider, webhook verification and order
# validation have been implemented and tested.
# Use provider-side webhook verification; never trust a browser redirect alone.

PAYMENTS_ENABLED=false
PAYMENT_CURRENCY=INR
PAYMENT_MODE=test

RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CASHFREE_ENABLED=false
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENVIRONMENT=sandbox

STRIPE_ENABLED=false
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PAYMENT_SUCCESS_URL=http://localhost:3000/account/payment-success.html
PAYMENT_FAILURE_URL=http://localhost:3000/account/payment-failure.html
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300


# -----------------------------------------------------------------------------
# 9. SUBSCRIPTIONS AND BILLING
# -----------------------------------------------------------------------------

SUBSCRIPTIONS_ENABLED=false
SUBSCRIPTION_DEFAULT_CURRENCY=INR
SUBSCRIPTION_GRACE_PERIOD_DAYS=3
SUBSCRIPTION_RENEWAL_ENABLED=false
SUBSCRIPTION_REMINDERS_ENABLED=false

BILLING_JOB_ENABLED=false
BILLING_JOB_BATCH_SIZE=100


# -----------------------------------------------------------------------------
# 10. AI INTEGRATION
# -----------------------------------------------------------------------------
# Enable only after configuring a supported provider and reviewing data handling.
# Do not send personal documents or sensitive applicant data without authorization.

AI_ENABLED=false
AI_PROVIDER=
AI_API_URL=
AI_API_KEY=
AI_MODEL=

AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=2000
AI_LOG_PROMPTS=false
AI_SEND_PERSONAL_DATA=false


# -----------------------------------------------------------------------------
# 11. SEARCH AND MAPS
# -----------------------------------------------------------------------------

SEARCH_ENABLED=true
SEARCH_PROVIDER=
SEARCH_API_KEY=

MAPS_ENABLED=false
MAPS_PROVIDER=
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=


# -----------------------------------------------------------------------------
# 12. RATE LIMITING
# -----------------------------------------------------------------------------

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

PASSWORD_RESET_RATE_LIMIT_MAX_REQUESTS=5
EMAIL_VERIFICATION_RATE_LIMIT_MAX_REQUESTS=10

UPLOAD_RATE_LIMIT_WINDOW_MS=900000
UPLOAD_RATE_LIMIT_MAX_REQUESTS=20


# -----------------------------------------------------------------------------
# 13. LOGGING AND MONITORING
# -----------------------------------------------------------------------------

LOG_LEVEL=info
LOG_FORMAT=json
LOG_TO_CONSOLE=true
LOG_TO_FILE=false
LOG_DIRECTORY=storage/logs

HTTP_LOGGING_ENABLED=true
HTTP_LOG_FORMAT=combined
LOG_REDACT_SENSITIVE_FIELDS=true

ERROR_TRACKING_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_EXPOSE_DETAILS=false


# -----------------------------------------------------------------------------
# 14. BACKGROUND QUEUES AND WORKERS
# -----------------------------------------------------------------------------

QUEUE_ENABLED=false
QUEUE_DRIVER=redis
QUEUE_PREFIX=medorbits:queue:

WORKER_CONCURRENCY=2
WORKER_MAX_RETRIES=3
WORKER_RETRY_DELAY_MS=5000

SCHEDULER_ENABLED=false
NOTIFICATION_JOBS_ENABLED=false
EMAIL_JOBS_ENABLED=false
DOCUMENT_CLEANUP_JOB_ENABLED=false
REPORT_GENERATION_JOB_ENABLED=false


# -----------------------------------------------------------------------------
# 15. SMS AND WHATSAPP
# -----------------------------------------------------------------------------

SMS_ENABLED=false
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=
SMS_OTP_TTL_SECONDS=300
SMS_OTP_MAX_ATTEMPTS=5

WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=


# -----------------------------------------------------------------------------
# 16. MEDORBITS PLATFORM FEATURES
# -----------------------------------------------------------------------------

ADMISSIONS_ENABLED=true
COUNSELLING_ENABLED=true
COLLEGE_DIRECTORY_ENABLED=true
COURSE_DIRECTORY_ENABLED=true
STUDY_ABROAD_ENABLED=true

JOBS_ENABLED=true
INTERNSHIPS_ENABLED=true
EMPLOYER_REGISTRATION_ENABLED=true
RECRUITMENT_ENABLED=true
CAREER_GUIDANCE_ENABLED=true

SUPPORT_TICKETS_ENABLED=true
CONTACT_FORMS_ENABLED=true
NOTIFICATIONS_ENABLED=true

ADMIN_PANEL_ENABLED=true
ADMIN_MFA_REQUIRED=true


# -----------------------------------------------------------------------------
# 17. ADMIN BOOTSTRAP AND INTERNAL ACCESS
# -----------------------------------------------------------------------------
# Leave bootstrap disabled during normal operation.
# If enabled for a controlled initial setup, use a strong unique password.

BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
INTERNAL_API_TOKEN=


# -----------------------------------------------------------------------------
# 18. PRIVACY, CONSENT AND ANALYTICS
# -----------------------------------------------------------------------------

PRIVACY_CONTROLS_ENABLED=true
COOKIE_CONSENT_ENABLED=true

ANALYTICS_ENABLED=false
MARKETING_TRACKING_ENABLED=false

AUDIT_LOG_RETENTION_DAYS=365
TEMP_FILE_RETENTION_HOURS=24

ANALYTICS_PROVIDER=
GOOGLE_ANALYTICS_ID=


# -----------------------------------------------------------------------------
# 19. EXTERNAL HTTP REQUESTS AND WEBHOOKS
# -----------------------------------------------------------------------------

HTTP_CLIENT_TIMEOUT_MS=15000
EXTERNAL_API_MAX_RETRIES=2
EXTERNAL_API_RETRY_DELAY_MS=1000

WEBHOOK_SIGNATURE_REQUIRED=true
WEBHOOK_MAX_CLOCK_SKEW_SECONDS=300


# -----------------------------------------------------------------------------
# 20. DEPLOYMENT AND LIFECYCLE
# -----------------------------------------------------------------------------

DEPLOYMENT_ENVIRONMENT=local
RELEASE_VERSION=1.0.0

STARTUP_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000


# -----------------------------------------------------------------------------
# 21. TESTING
# -----------------------------------------------------------------------------
# Use a dedicated test database and Redis instance if tests need them.
# Never point destructive tests at production services.

TEST_DATABASE_URL=
TEST_REDIS_URL=

TEST_EMAIL_ENABLED=false
TEST_PAYMENTS_ENABLED=false
TEST_AI_ENABLED=false

ENABLE_DEBUG_ROUTES=false
ENABLE_TEST_ENDPOINTS=false
