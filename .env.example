MAILGUN_DOMAIN=

--------------------------------------------------–

07. FILE UPLOADS AND PRIVATE DOCUMENTS

--------------------------------------------------–

Never mount private storage as a public static directory.

Validate file signatures, size, extension and content; MIME type alone is

insufficient. Scan untrusted documents before making them available.

UPLOADS_ENABLED=true
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=storage/private
STORAGE_TEMP_PATH=storage/temporary

UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_MAX_FILES=10
UPLOAD_MAX_TOTAL_SIZE_MB=50
UPLOAD_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png

PRIVATE_DOCUMENTS_ENABLED=true
DOCUMENTS_REQUIRE_AUTHENTICATION=true
DOCUMENTS_REQUIRE_AUTHORIZATION=true

TEMP_FILE_TTL_HOURS=24
UPLOAD_CLEANUP_ENABLED=true

MALWARE_SCAN_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

S3_ENABLED=false
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=

--------------------------------------------------–

