EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_CONNECTION_TIMEOUT_MS=10000

EMAIL_FROM_NAME=MedOrbits
