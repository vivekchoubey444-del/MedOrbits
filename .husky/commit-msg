#!/usr/bin/env sh
# MedOrbits commit message validation
# Format: type(scope): description
# Examples:
#   feat(auth): add email verification
#   fix(api): handle missing application ID
#   docs: update installation guide
#   chore(deps): update dependencies
commit_msg_file="$1"
if [ -z "$commit_msg_file" ] || [ ! -f "$commit_msg_file" ]; then
    echo "ERROR: Commit message file was not provided or does not exist."
    exit 1
fi
# Read the first non-empty, non-comment line.
commit_msg=$(
    grep -v '^[[:space:]]*#' "$commit_msg_file" |
    sed '/^[[:space:]]*$/d' |
    head -n 1
)
if [ -z "$commit_msg" ]; then
    echo ""
    echo "ERROR: Commit message is empty."
    exit 1
fi
# Validate Conventional Commit format.
if ! printf '%s\n' "$commit_msg" | grep -Eq \
    '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9._/-]+\))?!?: [^[:space:]].{0,99}$'; then
    echo ""
    echo "Invalid commit message format."
    echo ""
    echo "Use: type(scope): short description"
    echo ""
    echo "Allowed types:"
    echo "  feat, fix, docs, style, refactor, perf,"
    echo "  test, build, ci, chore, revert"
    echo ""
    echo "Examples:"
    echo "  feat(auth): add email verification"
    echo "  fix(api): handle missing application ID"
    echo "  docs: update installation guide"
    echo "  chore(deps): update dependencies"
    echo "  feat(api)!: remove deprecated endpoint"
    echo ""
    exit 1
fi
echo "Commit message format validated."
exit 0