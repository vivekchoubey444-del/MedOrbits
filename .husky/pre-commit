#!/usr/bin/env sh
# MedOrbits pre-commit quality checks
# Purpose: Run configured quality checks before allowing a commit.
set -eu
echo ""
echo "MedOrbits: Running pre-commit checks..."
echo ""
# --------------------------------------------------
# 1. Locate the repository root
# --------------------------------------------------
if ! repo_root=$(git rev-parse --show-toplevel 2>/dev/null); then
    echo "ERROR: Unable to determine the Git repository root."
    exit 1
fi
cd "$repo_root"
# --------------------------------------------------
# 2. Verify required project files and tools
# --------------------------------------------------
if [ ! -f package.json ]; then
    echo "ERROR: package.json was not found at the repository root."
    exit 1
fi
if ! command -v node >/dev/null 2>&1; then
    echo "ERROR: Node.js is required to run pre-commit checks."
    exit 1
fi
if ! command -v npm >/dev/null 2>&1; then
    echo "ERROR: npm is required to run pre-commit checks."
    exit 1
fi
# --------------------------------------------------
# 3. Detect configured npm scripts
# --------------------------------------------------
has_script() {
    node -e '
        const fs = require("node:fs");
        try {
            const pkg = JSON.parse(
                fs.readFileSync("package.json", "utf8")
            );
            const name = process.argv[1];
            process.exit(
                pkg.scripts &&
                typeof pkg.scripts[name] === "string" &&
                pkg.scripts[name].trim() !== ""
                    ? 0
                    : 1
            );
        } catch (error) {
            console.error("ERROR: Unable to read package.json:", error.message);
            process.exit(2);
        }
    ' "$1"
}
# --------------------------------------------------
# 4. Run configured quality checks
# --------------------------------------------------
checks_run=0
run_check() {
    check_name=$1
    script_name=$2
    if has_script "$script_name"; then
        echo ""
        echo "----------------------------------------"
        echo "Running $check_name..."
        echo "----------------------------------------"
        npm run "$script_name"
        checks_run=$((checks_run + 1))
        echo "PASS: $check_name"
    else
        result=$?
        if [ "$result" -gt 1 ]; then
            echo "ERROR: Could not inspect npm script '$script_name'."
            exit 1
        fi
        echo "WARNING: Skipping $check_name; npm script '$script_name' is not configured."
    fi
}
# ESLint
run_check "ESLint" "lint"
# Prettier
run_check "Prettier formatting validation" "format:check"
# Automated tests
run_check "automated tests" "test"
# --------------------------------------------------
# 5. Report results
# --------------------------------------------------
echo ""
echo "========================================"
echo "MedOrbits: Pre-commit checks completed."
echo "Configured checks passed: $checks_run"
echo "========================================"
echo ""
exit 0