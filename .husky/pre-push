#!/usr/bin/env sh
# MedOrbits pre-push validation hook
# Purpose: Validate code quality and require automated tests before pushing.
set -eu
echo ""
echo "MedOrbits: Running pre-push checks..."
echo ""
# --------------------------------------------------
# 1. Locate repository root
# --------------------------------------------------
if ! repo_root=$(git rev-parse --show-toplevel 2>/dev/null); then
    echo "ERROR: Unable to determine the Git repository root."
    exit 1
fi
cd "$repo_root"
# --------------------------------------------------
# 2. Verify project configuration
# --------------------------------------------------
if [ ! -f package.json ]; then
    echo "ERROR: package.json was not found at the repository root."
    exit 1
fi
# --------------------------------------------------
# 3. Verify required tools
# --------------------------------------------------
if ! command -v node >/dev/null 2>&1; then
    echo "ERROR: Node.js is required for pre-push validation."
    exit 1
fi
if ! command -v npm >/dev/null 2>&1; then
    echo "ERROR: npm is required for pre-push validation."
    exit 1
fi
# --------------------------------------------------
# 4. Detect configured npm scripts
# --------------------------------------------------
has_script() {
    node -e '
        const fs = require("node:fs");
        try {
            const pkg = JSON.parse(
                fs.readFileSync("package.json", "utf8")
            );
            const name = process.argv[1];
            process.exit(
                pkg.scripts &&
                typeof pkg.scripts[name] === "string" &&
                pkg.scripts[name].trim() !== ""
                    ? 0
                    : 1
            );
        } catch (error) {
            console.error(
                "ERROR: Unable to read package.json:",
                error.message
            );
            process.exit(2);
        }
    ' "$1"
}
# --------------------------------------------------
# 5. Run ESLint when configured
# --------------------------------------------------
echo ""
echo "----------------------------------------"
echo "Checking ESLint configuration..."
echo "----------------------------------------"
if has_script lint; then
    echo "Running ESLint..."
    npm run lint
    echo "PASS: ESLint"
else
    script_status=$?
    if [ "$script_status" -gt 1 ]; then
        echo "ERROR: Unable to inspect the lint script."
        exit 1
    fi
    echo "WARNING: No lint script configured; skipping ESLint."
fi
# --------------------------------------------------
# 6. Require automated tests
# --------------------------------------------------
echo ""
echo "----------------------------------------"
echo "Checking automated tests..."
echo "----------------------------------------"
if has_script test; then
    echo "Running automated tests..."
    npm test
    echo "PASS: Automated tests"
else
    script_status=$?
    if [ "$script_status" -gt 1 ]; then
        echo "ERROR: Unable to inspect the test script."
        exit 1
    fi
    echo "ERROR: No test script configured in package.json."
    echo "Configure a working test script before pushing."
    exit 1
fi
# --------------------------------------------------
# 7. Report success
# --------------------------------------------------
echo ""
echo "========================================"
echo "MedOrbits: Pre-push checks passed."
echo "========================================"
echo ""
exit 0